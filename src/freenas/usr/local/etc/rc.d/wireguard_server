#!/bin/sh
#
# PROVIDE: wireguard_server
# REQUIRE: DAEMON middlewared
# KEYWORD: shutdown

# The net/wireguard-tools port ships a single "wireguard" rc script that acts on
# every interface named in wireguard_interfaces, so it cannot give the server a
# lifecycle independent of TrueCommand's wg0. This script owns wg1 (the server)
# alone, mirroring wireguard_client which owns wg2 for the same reason.
#
# It also exists because wg-quick(8) cannot be called from an rc script in the
# foreground on FreeBSD 15 -- see wireguard_server_start.

. /etc/rc.subr

name="wireguard_server"
rcvar="wireguard_server_enable"

: ${wireguard_server_enable:="NO"}
: ${wireguard_server_interface:="wg1"}
: ${wireguard_server_timeout:="15"}

start_cmd="wireguard_server_start"
stop_cmd="wireguard_server_stop"
status_cmd="wireguard_server_status"
extra_commands="status"

load_rc_config $name

_wg_conf="/usr/local/etc/wireguard/${wireguard_server_interface}.conf"

wireguard_server_up()
{
	/usr/local/bin/wg show "${wireguard_server_interface}" >/dev/null 2>&1
}

wireguard_server_start()
{
	if ! LD_LIBRARY_PATH=/usr/local/lib /usr/local/bin/midclt -t 30 call etc.generate wireguard >/dev/null 2>&1; then
		echo "failed to generate the wireguard server configuration"
		return 1
	fi

	if [ ! -r "${_wg_conf}" ]; then
		echo "wireguard server is not configured"
		return 1
	fi

	# middleware's SimpleService start is an rc restart, so start has to be a
	# no-op on an interface that is already up rather than an error.
	if wireguard_server_up; then
		return 0
	fi

	# wg-quick(8) brings the interface up and then backgrounds a route-monitor
	# daemon, but on FreeBSD 15 the script itself never returns -- measured
	# three ways in the internal development record, the interface comes up correctly and
	# wg-quick blocks indefinitely regardless of stdio redirection. Called in
	# the foreground it would hang service(8), middleware's service.start, and
	# /etc/rc at boot.
	#
	# So run it detached and wait for the interface it creates, which is the
	# real success condition. This restores the contract 13.3 got for free from
	# openvpn(8), which daemonized: start returns once the service is up.
	/usr/local/bin/wg-quick up "${wireguard_server_interface}" >/dev/null 2>&1 &
	_wg_pid=$!

	_waited=0
	_limit=$((wireguard_server_timeout * 4))
	while [ "${_waited}" -lt "${_limit}" ]; do
		if wireguard_server_up; then
			return 0
		fi
		# wg-quick exiting without the interface is a real failure (unreadable
		# config, bad key). Stop waiting for something that will never appear.
		if ! kill -0 "${_wg_pid}" 2>/dev/null; then
			echo "wg-quick exited without bringing ${wireguard_server_interface} up"
			return 1
		fi
		sleep 0.25
		_waited=$((_waited + 1))
	done

	echo "timed out after ${wireguard_server_timeout}s waiting for ${wireguard_server_interface}"
	return 1
}

wireguard_server_stop()
{
	if ! wireguard_server_up; then
		return 0
	fi

	# wg-quick down reads the config to tear down the routes it installed. If the
	# config has since been removed (an incomplete config makes the etc template
	# refuse to render, which unlinks it) wg-quick cannot run at all, and without
	# this fallback the interface would be stranded up with no way to stop it.
	if [ -r "${_wg_conf}" ]; then
		/usr/local/bin/wg-quick down "${wireguard_server_interface}"
	else
		echo "${_wg_conf} is missing; destroying ${wireguard_server_interface} directly"
		/sbin/ifconfig "${wireguard_server_interface}" destroy
	fi
}

wireguard_server_status()
{
	if wireguard_server_up; then
		echo "wireguard server ${wireguard_server_interface} is up"
		return 0
	fi

	echo "wireguard server ${wireguard_server_interface} is down"
	return 1
}

run_rc_command "$1"
