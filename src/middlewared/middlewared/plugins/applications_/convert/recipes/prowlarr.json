{
  "app": "prowlarr",
  "recipe_version": 1,
  "kind": "generic",
  "status": "draft",
  "title": "Prowlarr",
  "comment": "Prowlarr keeps everything in one data directory (-data=): database, config.xml, backups. The FreeBSD package's rc.d script and the LinuxServer image both point it at one directory; the Daemonless image runs it with -data=/config.",
  "target": {
    "catalog_id": "daemonless:prowlarr",
    "volume": "config",
    "layout": {
      "data": ""
    },
    "uid": 1000,
    "gid": 1000,
    "port": 9696
  },
  "sources": {
    "jail": {
      "pkg": "prowlarr",
      "rc_script": "prowlarr",
      "rc_data_var": "prowlarr_data_dir",
      "detect": [
        "usr/local/etc/rc.d/prowlarr"
      ],
      "data": "usr/local/prowlarr",
      "uid": 359
    },
    "linux": {
      "images": [
        "lscr.io/linuxserver/prowlarr",
        "ghcr.io/linuxserver/prowlarr",
        "docker.io/linuxserver/prowlarr",
        "ghcr.io/hotio/prowlarr"
      ],
      "data": "/config",
      "uid": 1000,
      "export": {
        "image": "lscr.io/linuxserver/prowlarr",
        "tag_template": "version-{version}",
        "user": "puid"
      }
    }
  },
  "config": {
    "allow": [],
    "deny": []
  },
  "carry": [
    {
      "from": "{data}",
      "to": "",
      "required": true
    }
  ],
  "drop": [
    "logs",
    "cron entries",
    "packages installed beside the application",
    "TLS certificate files",
    "sidecar services"
  ]
}
